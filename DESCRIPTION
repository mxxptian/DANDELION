Package: DANDELION
Type: Package
Title: Discovery of Candidate Disease Genes Using Trans-Regulatory Effects
Version: 0.1.0
Authors@R: 
    person(
        given = "Peixin",
        family = "Tian",
        role = c("aut", "cre"),
